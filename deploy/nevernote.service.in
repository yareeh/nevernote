[Unit]
Description=Nevernote archive viewer (read-only Evernote ENEX web UI + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=ENEX_DIR=@ENEX_DIR@
Environment=DATA_DIR=@DATA_DIR@
Environment=HOST=0.0.0.0
Environment=PORT=@PORT@
Environment=PYTHONUNBUFFERED=1
# Rebuilds the index when the ENEX files changed, then serves.
ExecStart=@ROOT@/.venv/bin/enex-viewer serve
Restart=on-failure
RestartSec=5
# Indexing a large export takes minutes before the port opens.
TimeoutStartSec=0
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
