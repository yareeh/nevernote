# Template for .env (created by `make setup` with generated passwords).
# .env and .env.* are gitignored.

# Docker Compose project; separate instances (e.g. .env.test) need their own.
COMPOSE_PROJECT_NAME=my-joplin

# URL the Mac (and this box) use to reach Joplin Server. Must match exactly
# what clients put in their sync settings. Reserve this IP in your router's
# DHCP settings so it doesn't change under you.
APP_BASE_URL=http://192.168.1.123:22300
APP_PORT=22300

# Local state for this instance (CLI profile, Evernote backup DB, dumps) and
# where `make import` reads .enex files from. Relative to the repo root.
DATA_DIR=data
ENEX_DIR=data/enex

# Postgres (internal to the compose network only)
POSTGRES_USER=joplin
POSTGRES_DB=joplin
POSTGRES_PASSWORD=change-me

# Joplin Server admin. A fresh server has admin@localhost / admin;
# `make server-user` rotates it to this password.
JOPLIN_ADMIN_EMAIL=admin@localhost
JOPLIN_ADMIN_PASSWORD=change-me

# Your regular (non-admin) Joplin Server account; the CLI and Mac sync as this.
# Joplin Server rejects weak passwords.
JOPLIN_USER_EMAIL=you@example.com
JOPLIN_USER_PASSWORD=change-me
JOPLIN_USER_NAME="Your Name"

# How to convert ENEX notes: md (editable Markdown) or html (faithful archive)
IMPORT_OUTPUT_FORMAT=md
