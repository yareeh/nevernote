# Copy to .env to override the defaults, then run `make viewer-up`.
# Relative paths are relative to the repo root.

# Directory with the .enex files to serve (one per notebook; stacks are
# subdirectories). `make evernote-export` writes to data/enex.
ENEX_DIR=./data/enex

# Where the viewer keeps its index and attachment files. Derived from the
# ENEX files and rebuilt when they change; safe to delete.
DATA_DIR=./data/viewer

# Port on this box for the viewer.
VIEWER_PORT=8765
