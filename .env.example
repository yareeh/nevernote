# Copy to .env to override the defaults, then run `make viewer-up`.
# Relative paths are relative to the repo root.

# Where the viewer's index and attachment files are (written by `make refresh`,
# mounted read-only into the container).
DATA_DIR=./data/viewer

# Port on this box for the viewer.
VIEWER_PORT=8765

# Only for `make dev` (running the viewer from source): .enex files to index.
# ENEX_DIR=./tmp/evernote
