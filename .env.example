# Copy to .env and fill in. .env is gitignored.

# URL the Mac (and this box) use to reach Joplin Server. Must match exactly
# what clients put in their sync settings. Reserve this IP in your router's
# DHCP settings so it doesn't change under you.
APP_BASE_URL=http://192.168.1.123:22300
APP_PORT=22300

# Postgres (internal to the compose network only)
POSTGRES_USER=joplin
POSTGRES_DB=joplin
POSTGRES_PASSWORD=change-me-long-random

# Joplin Server admin (default is admin@localhost / admin — change it).
# Used by `make server-user` to create your regular user.
JOPLIN_ADMIN_EMAIL=admin@localhost
JOPLIN_ADMIN_PASSWORD=admin

# Your regular (non-admin) Joplin Server account; the CLI and Mac sync as this.
JOPLIN_USER_EMAIL=you@example.com
JOPLIN_USER_PASSWORD=change-me
JOPLIN_USER_NAME=Your Name

# How to convert ENEX notes: md (editable Markdown) or html (faithful archive)
IMPORT_OUTPUT_FORMAT=md
